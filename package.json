{
  "name": "roam",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive travel exploration platform combining itineraries, maps, GPS, nearby places, routing, and recommendations.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "regions:manifest": "node tools/region-builder/package-manifest.mjs",
    "regions:rebuild-rich": "node tools/region-builder/rebuild-rich-regions.mjs",
    "routing:match-portugal-tolls": "node tools/region-builder/build-portugal-toll-events.mjs",
    "gps-replay": "vite tools/gps-replay --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.1",
    "@tomickigrzegorz/leaflet-rotate": "0.2.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.6.0",
    "pmtiles": "^4.4.1",
    "protomaps-leaflet": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "vite": "^7.1.0"
  }
}
