import { rankTransitJourneys } from './transit-journey-ranker.js';

const DEFAULT_CANDIDATE_REQUESTS = Object.freeze([
  {
    mode: 'bus,tube,dlr,overground,tram,elizabeth-line',
    alternativeRoutes: true
  },
  {
    mode: 'tube',
    alternativeRoutes: true
  },
  {
    /*
     * A fastest-time Tube query can prefer a shorter walk to the wrong
     * station and then add an unnecessary interchange. Ask TfL separately
     * for the least-interchange Tube journey so routes such as walking
     * directly to Piccadilly Circus and taking Bakerloo northbound are
     * present in Atlas' candidate set.
     */
    mode: 'tube',
    journeyPreference: 'leastinterchange',
    alternativeRoutes: true
  },
  {
    mode: 'elizabeth-line',
    alternativeRoutes: false
  }
]);

const COMPETITIVE_DURATION_RATIO = 1.75;
const COMPETITIVE_DURATION_MARGIN_MINUTES = 30;

function geometryPoints(geometry) {
  if (geometry == null) return [];

  // Atlas Transit currently returns TfL geometry as a JSON string of
  // [lat, lon] coordinate pairs, for example:
  // "[[51.5010,-0.1246],[51.5013,-0.1249]]".
  // Accept an already-decoded array too so the bridge is not coupled to
  // the transport service serialisation detail.
  let coordinates = geometry;
  if (typeof geometry === 'string') {
    const text = geometry.trim();

    if (text.startsWith('[')) {
      try {
        coordinates = JSON.parse(text);
      } catch {
        coordinates = null;
      }
    } else {
      // Keep compatibility with WKT LINESTRING(lon lat, ...).
      const match = text.match(/^LINESTRING\s*\((.*)\)$/i);
      if (!match) return [];
      return match[1]
        .split(',')
        .map(pair => {
          const [lon, lat] = pair.trim().split(/\s+/).map(Number);
          return { lat, lon };
        })
        .filter(validPoint);
    }
  }

  if (!Array.isArray(coordinates)) return [];

  return coordinates
    .map(pair => {
      if (!Array.isArray(pair) || pair.length < 2) return null;
      const lat = Number(pair[0]);
      const lon = Number(pair[1]);
      return { lat, lon };
    })
    .filter(validPoint);
}

function validPoint(point) {
  return point != null &&
    Number.isFinite(point.lat) &&
    Number.isFinite(point.lon) &&
    point.lat >= -90 && point.lat <= 90 &&
    point.lon >= -180 && point.lon <= 180;
}

export class TransitJourneyBridge {
  constructor({ provider }) {
    if (!provider?.journeys) throw new TypeError('TransitJourneyBridge requires a journey provider.');
    this.provider = provider;
  }

  async plan(origin, destination, options = {}) {
    const candidateGroups =
      options.mode
        ? [
            {
              mode: options.mode,
              journeys: await this.provider.journeys(
                origin,
                destination,
                options
              )
            }
          ]
        : await this.#candidateGroups(
            origin,
            destination,
            options
          );

    const normalizedJourneys =
      candidateGroups.flatMap(
        ({ mode, journeys }) =>
          journeys.map(journey => ({
            ...journey,
            candidatePool: mode,
            origin: { ...origin },
            destination: { ...destination },
            sequence: journey.legs.map(
              (leg, index) =>
                this.#step(leg, index)
            )
          }))
      );

    /*
     * Rank once so the best departure of a duplicated route family wins,
     * then remove equivalent route families and rank the unique set again.
     * This prevents TfL returning three Central-line departures from filling
     * the whole Atlas alternatives list while Bakerloo/Elizabeth disappear.
     */
    const rankedCandidates =
      rankTransitJourneys(
        normalizedJourneys
      );

    const uniqueJourneys = [];
    const signatures = new Set();

    for (const journey of rankedCandidates) {
      const signature =
        this.#journeySignature(
          journey
        );

      if (signatures.has(signature)) {
        continue;
      }

      signatures.add(signature);
      uniqueJourneys.push(journey);
    }

    const competitiveJourneys =
      this.#competitiveJourneys(
        uniqueJourneys
      );

    return rankTransitJourneys(
      competitiveJourneys
    );
  }

  async enrichOperationalDetails(
    journey,
    {
      signal = null
    } = {}
  ) {
    if (
      !journey ||
      !Array.isArray(journey.sequence) ||
      typeof this.provider?.arrivals !== 'function'
    ) {
      return journey;
    }

    const sequence =
      await Promise.all(
        journey.sequence.map(
          async step => {
            if (
              step?.kind !== 'transit' ||
              !step.departureStopId
            ) {
              return step;
            }

            let predictions;

            try {
              predictions =
                await this.provider.arrivals(
                  step.departureStopId,
                  {
                    line: step.line,
                    signal
                  }
                );
            } catch {
              return step;
            }

            if (!predictions.length) {
              return step;
            }

            const targetDeparture =
              Date.parse(
                step.departureTime ?? ''
              );

            const candidates =
              predictions
                .map(prediction => {
                  const expected =
                    Date.parse(
                      prediction?.expectedArrival ??
                      ''
                    );

                  const delta =
                    Number.isFinite(targetDeparture) &&
                    Number.isFinite(expected)
                      ? Math.abs(
                          expected -
                          targetDeparture
                        )
                      : Number(
                          prediction?.timeToStation ??
                          Infinity
                        ) * 1000;

                  return {
                    prediction,
                    delta
                  };
                })
                .sort(
                  (a, b) =>
                    a.delta - b.delta
                );

            const prediction =
              candidates[0]?.prediction;

            if (!prediction) {
              return step;
            }

            /*
             * TfL commonly exposes Tube operational information
             * in a form such as:
             *
             *   "Southbound - Platform 4"
             *
             * Split that into the compact Atlas fields.
             */
            const rawPlatform =
              String(
                prediction?.platformName ??
                ''
              ).trim();

            const cardinalMatch =
              rawPlatform.match(
                /\b(northbound|southbound|eastbound|westbound)\b/i
              );

            const platformMatch =
              rawPlatform.match(
                /\bplatform\s*([A-Za-z0-9]+)\b/i
              );

            const rawDirection =
              String(
                prediction?.direction ??
                ''
              ).trim();

            const operationalDirection =
              cardinalMatch?.[1] ??
              (
                /^(north|south|east|west)bound$/i.test(
                  rawDirection
                )
                  ? rawDirection
                  : null
              );

            const operationalPlatform =
              platformMatch?.[1] ??
              (
                rawPlatform &&
                !cardinalMatch
                  ? rawPlatform
                  : null
              );

            const destination =
              String(
                prediction?.destinationName ??
                prediction?.towards ??
                ''
              ).trim();

            return {
              ...step,

              departurePlatform:
                operationalPlatform ??
                step.departurePlatform ??
                null,

              /*
               * Only replace direction when TfL gives us an actual
               * cardinal operational direction.
               */
              direction:
                operationalDirection ??
                step.direction ??
                null,

              operationalDestination:
                destination ||
                null,

              expectedDepartureTime:
                prediction?.expectedArrival ??
                null
            };
          }
        )
      );

    return {
      ...journey,
      sequence
    };
  }

  async #candidateGroups(
    origin,
    destination,
    options
  ) {
    const requests =
      DEFAULT_CANDIDATE_REQUESTS.map(
        async requestOptions => ({
          mode:
            requestOptions.journeyPreference
              ? `${requestOptions.mode}:${requestOptions.journeyPreference}`
              : requestOptions.mode,
          journeys:
            await this.provider.journeys(
              origin,
              destination,
              {
                ...options,
                ...requestOptions,
                preference:
                  requestOptions.journeyPreference ??
                  options.preference
              }
            )
        })
      );

    const results =
      await Promise.allSettled(
        requests
      );

    const successful =
      results
        .filter(
          result =>
            result.status === 'fulfilled'
        )
        .map(result => result.value);

    if (successful.length) {
      return successful;
    }

    const rejected =
      results.find(
        result =>
          result.status === 'rejected'
      );

    throw (
      rejected?.reason ??
      new Error(
        'TfL journey candidate requests failed.'
      )
    );
  }


  #competitiveJourneys(journeys) {
    if (!journeys.length) {
      return [];
    }

    const durations = journeys
      .map(journey =>
        Number(journey?.metrics?.durationMinutes ?? journey?.durationMinutes)
      )
      .filter(duration =>
        Number.isFinite(duration) && duration >= 0
      );

    if (!durations.length) {
      return journeys;
    }

    const fastest = Math.min(...durations);
    const maximumCompetitiveDuration = Math.max(
      fastest * COMPETITIVE_DURATION_RATIO,
      fastest + COMPETITIVE_DURATION_MARGIN_MINUTES
    );

    return journeys.filter(journey => {
      const duration = Number(
        journey?.metrics?.durationMinutes ?? journey?.durationMinutes
      );

      return !Number.isFinite(duration) ||
        duration <= maximumCompetitiveDuration;
    });
  }

  #journeySignature(journey) {
    const sequence =
      Array.isArray(journey?.sequence)
        ? journey.sequence
        : [];

    const transit =
      sequence
        .filter(
          step =>
            step?.kind === 'transit'
        )
        .map(step =>
          [
            step?.mode ?? '',
            step?.line ?? '',
            step?.fromName ?? '',
            step?.toName ?? ''
          ].join(':')
        );

    if (transit.length) {
      return transit.join('|');
    }

    return sequence
      .map(step =>
        [
          step?.kind ?? '',
          step?.fromName ?? '',
          step?.toName ?? ''
        ].join(':')
      )
      .join('|');
  }

  #step(leg, index) {
    const points = geometryPoints(leg.geometry);

    if (!points.length) {
      throw new Error(
        `TfL geometry unsupported: ${String(leg.geometry).slice(0, 200)}`
      );
    }
    const isWalking = leg.mode === 'walking';
    return {
      index,
      kind: isWalking ? 'walk' : 'transit',
      mode: leg.mode,
      line: leg.line,
      fromName: leg.fromName,
      toName: leg.toName,
      durationMinutes: leg.durationMinutes,
      departureTime: leg.departureTime,
      arrivalTime: leg.arrivalTime,
      instruction: leg.instruction,
      instructionDetailed: leg.instructionDetailed,
      direction: leg.direction,
      departureStopId: leg.departureStopId,
      departurePlatform: leg.departurePlatform,
      departureIndicator: leg.departureIndicator,
      departureStopLetter: leg.departureStopLetter,
      arrivalStopId: leg.arrivalStopId,
      arrivalPlatform: leg.arrivalPlatform,
      arrivalIndicator: leg.arrivalIndicator,
      arrivalStopLetter: leg.arrivalStopLetter,
      intermediateStops: leg.intermediateStops,
      stopCount: leg.stopCount,
      disruptions: leg.disruptions,
      points,
      start: points[0] ?? null,
      end: points.at(-1) ?? null,
      navigation: isWalking ? 'atlas-offline' : 'provider-guidance'
    };
  }
}

export { geometryPoints };
